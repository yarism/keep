{
  "name": "keep",
  "productName": "Keep",
  "version": "1.0.16",
  "description": "A Tower-inspired Git GUI client",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "test": "node --test \"test/*.test.js\" \"test/*.test.mjs\"",
    "test:watch": "node --test --watch \"test/*.test.js\" \"test/*.test.mjs\"",
    "dist": "electron-builder --mac",
    "dist:win": "electron-builder --win nsis",
    "dist:linux": "electron-builder --linux AppImage",
    "dist:all": "electron-builder --mac --win nsis --linux AppImage",
    "preversion": "npm test",
    "postversion": "git push --follow-tags"
  },
  "keywords": [
    "git",
    "gui",
    "electron"
  ],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "devDependencies": {
    "canvas": "^3.2.3",
    "electron": "^41.2.1",
    "electron-builder": "^26.8.1"
  },
  "build": {
    "appId": "com.keep.app",
    "productName": "Keep",
    "publish": {
      "provider": "github",
      "owner": "yarism",
      "repo": "keep"
    },
    "mac": {
      "icon": "assets/icon.icns",
      "artifactName": "${productName}-mac-${arch}.${ext}",
      "category": "public.app-category.developer-tools",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "x64",
            "arm64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "hardenedRuntime": true,
      "notarize": true
    },
    "win": {
      "icon": "assets/icon.png",
      "artifactName": "${productName}-win-${arch}.${ext}",
      "target": "nsis"
    },
    "linux": {
      "icon": "assets/icon.png",
      "artifactName": "${productName}-linux-${arch}.${ext}",
      "target": "AppImage",
      "category": "Development"
    },
    "files": [
      "main.js",
      "preload.js",
      "git.js",
      "forge-api.js",
      "release.js",
      "menu.js",
      "updater.js",
      "window-bounds.js",
      "renderer/**/*",
      "assets/icon.png",
      "package.json"
    ]
  },
  "dependencies": {
    "electron-updater": "^6.8.9"
  }
}
